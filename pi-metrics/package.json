{
  "name": "@yuru7/pi-metrics",
  "version": "0.1.0",
  "description": "A Pi extension that prints one dim metrics line when a run settles (elapsed, TPS, TTFT, tokens) and shows the live elapsed time in the working indicator",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "metrics",
    "tps",
    "ttft"
  ],
  "license": "MIT",
  "author": "yuru7",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuru7/my-pi-extensions.git",
    "directory": "pi-metrics"
  },
  "bugs": {
    "url": "https://github.com/yuru7/my-pi-extensions/issues"
  },
  "homepage": "https://github.com/yuru7/my-pi-extensions/tree/main/pi-metrics#readme",
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test",
    "package:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^24.5.2",
    "typescript": "^7.0.2"
  }
}
