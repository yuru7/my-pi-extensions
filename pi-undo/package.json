{
  "name": "pi-rollback",
  "version": "0.1.0",
  "description": "A Pi extension that checkpoints file changes and rolls back conversation turns",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "rollback",
    "checkpoint"
  ],
  "license": "MIT",
  "author": "yuru7",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuru7/my-pi-extensions.git",
    "directory": "pi-rollback"
  },
  "bugs": {
    "url": "https://github.com/yuru7/my-pi-extensions/issues"
  },
  "homepage": "https://github.com/yuru7/my-pi-extensions/tree/main/pi-rollback#readme",
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-rollback.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.5.2",
    "typescript": "^7.0.2"
  }
}
