{
  "name": "@yuru7/pi-ask-user",
  "version": "0.1.0",
  "description": "A Pi extension that lets the model ask structured questions and returns the answers, with an idle timeout, countdown, and Ctrl+O collapse.",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "ask-user",
    "questionnaire"
  ],
  "license": "MIT",
  "author": "yuru7",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuru7/my-pi-extensions.git",
    "directory": "pi-ask-user"
  },
  "files": [
    "extensions",
    "src",
    "locales",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./extensions/index.ts",
    "./events": "./src/events.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "package:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-server": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-ai": "^0.85.0",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-server": "^0.85.0",
    "@earendil-works/pi-tui": "^0.85.0",
    "@types/node": "^24.5.2",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  }
}
