{
  "name": "@yuru7/pi-auto-title",
  "version": "0.1.0",
  "description": "A Pi extension that manages the terminal tab title: an AI-generated session title plus a running/idle status indicator",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "title",
    "terminal-title",
    "status"
  ],
  "license": "MIT",
  "author": "yuru7",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuru7/my-pi-extensions.git",
    "directory": "pi-auto-title"
  },
  "bugs": {
    "url": "https://github.com/yuru7/my-pi-extensions/issues"
  },
  "homepage": "https://github.com/yuru7/my-pi-extensions/tree/main/pi-auto-title#readme",
  "files": [
    "extensions",
    "src",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "package:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^24.5.2",
    "typescript": "^7.0.2"
  }
}
