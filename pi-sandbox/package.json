{
  "name": "@yuru7/pi-sandbox",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.4.2",
  "description": "Process-level, path-transparent sandbox for Pi coding agent with fail-closed workspace protection (bwrap, landlock, seatbelt, windows-acl) and denial-first AI auto-review escalation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuru7/my-pi-extensions.git",
    "directory": "pi-sandbox"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "sandbox",
    "auto-review"
  ],
  "files": [
    "index.ts",
    "src/",
    "resources/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@deepseek-ai/node-addon-system": "^0.1.2",
    "@earendil-works/pi-schema": "^1.5.0",
    "koffi": "^3.3.2"
  }
}
